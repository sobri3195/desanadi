    "react-hook-form": "^7.71.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
